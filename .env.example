# Environment variables for the AI Engineering Team engine.
# Copy this file to .env and fill in values locally. Never commit .env.
#
# Key names only in this file. Values stay empty.
# Only the trusted Workflow Engine reads these values. Agent tools, handoff
# bundles, prompts, transcripts and child processes never receive them.
#
# Model identifiers, pricing and limits live in config/aiteam.toml, not here.

# API key for the currently assumed OpenAI adapter. The adapter is replaceable,
# so this name may change when a different provider is selected.
OPENAI_API_KEY=
